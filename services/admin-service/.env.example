SERVICE_NAME=kira-admin
ENVIRONMENT=development

# Hostnames are for local host (Alembic, pytest). Docker Compose overrides these for containers.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kira
REDIS_URL=redis://:redis-local-dev@localhost:6379/5
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Must match identity-service SECRET_KEY (used to verify JWTs)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO
