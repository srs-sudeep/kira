SERVICE_NAME=kira-channel-engine
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kira_channel
REDIS_URL=redis://localhost:6379/3
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALLOWED_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# AES-256-GCM key for OTA credential encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-in-production-use-openssl-rand-hex-32

# Kafka topic names
KAFKA_TOPIC_ARI_UPDATED=ari.updated
KAFKA_TOPIC_SYNC_RESULT=channel.sync.result
KAFKA_TOPIC_BOOKING_RAW=channel.booking.raw

# Consumer group ID
KAFKA_CONSUMER_GROUP=channel-engine

# Circuit breaker: consecutive failures before marking channel as error
CIRCUIT_BREAKER_THRESHOLD=5

# Booking pull interval in seconds (Celery beat)
BOOKING_PULL_INTERVAL=60
