SERVICE_NAME=kira-reservation
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/kira
REDIS_URL=redis://:redis-local-dev@redis:6379/2
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Must match identity-service SECRET_KEY (used to verify JWTs)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO

# AES-256-GCM key for guest PII (email, phone). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-in-production-use-openssl-rand-hex-32

# Internal URL of the rate-inventory-service (used for ARI availability checks)
RATE_INVENTORY_SERVICE_URL=http://rate-inventory-service:8002

# Email — leave SENDGRID_API_KEY blank in dev
SENDGRID_API_KEY=
FROM_EMAIL=noreply@yourdomain.com
