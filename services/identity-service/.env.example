SERVICE_NAME=kira-identity
ENVIRONMENT=development

# Hostnames are for local host (Alembic, pytest). Docker Compose overrides these for containers.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kira
REDIS_URL=redis://:redis-local-dev@localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO

MFA_ISSUER=KIRA Hotel Manager

# Email — leave SENDGRID_API_KEY blank in dev (emails are logged, viewable in Mailhog)
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@kirahms.com
