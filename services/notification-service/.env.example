SERVICE_NAME=kira-notification
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/kira
REDIS_URL=redis://redis:6379/4
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Must match identity-service SECRET_KEY (used to verify JWTs)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO

# Email — leave SENDGRID_API_KEY blank in dev
SENDGRID_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# Kafka topics consumed
KAFKA_TOPIC_RESERVATION_CREATED=reservation.created
KAFKA_TOPIC_RESERVATION_CANCELLED=reservation.cancelled
KAFKA_TOPIC_CHANNEL_SYNC_FAILED=channel.sync.failed

KAFKA_CONSUMER_GROUP=notification-service
