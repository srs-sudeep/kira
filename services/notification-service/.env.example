SERVICE_NAME=kira-notification
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kira_notification
REDIS_URL=redis://localhost:6379/4
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALLOWED_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Email — leave blank to skip sending (emails are logged to stdout in dev)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# Kafka topics consumed
KAFKA_TOPIC_RESERVATION_CREATED=reservation.created
KAFKA_TOPIC_RESERVATION_CANCELLED=reservation.cancelled
KAFKA_TOPIC_CHANNEL_SYNC_FAILED=channel.sync.failed

KAFKA_CONSUMER_GROUP=notification-service
